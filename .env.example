# ==============================================================================
# ANONEURX PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Main Domain: anoneurx.com
# ==============================================================================

# Main Application & Domain Settings
VITE_MAIN_DOMAIN=anoneurx.com
VITE_APP_URL=https://anoneurx.com

# ------------------------------------------------------------------------------
# Resilient Microservices API Endpoints
# ------------------------------------------------------------------------------

# Core Platform Backend API
VITE_API_URL=https://api.anoneurx.com

# Dedicated Authentication & Identity API
VITE_AUTH_API_URL=https://auth.anoneurx.com

# Dedicated Open Source Ecosystem API
VITE_OPENSOURCE_API_URL=https://opensource.anoneurx.com

# Dedicated Cloud & System Console API
VITE_CONNECT_API_URL=https://connect.anoneurx.com

# Resiliency & Fallback Engine Settings
VITE_ENABLE_MOCK_FALLBACK=true
